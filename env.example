# Copy this file to .env.local in the project root and set your email token.
# Next.js loads .env.local when you start or build the dashboard.
# Keep your actual .env.local private; Git ignores it.

# Private SQLite database and encryption-key directory.
# Relative paths resolve from the project directory. Default: .maildesk
# For a custom location, use a private absolute path outside the Git repository.
MAILDESK_DATA_DIR=.maildesk

# Disable Next.js telemetry. The supplied launchers also set this to 1.
NEXT_TELEMETRY_DISABLED=1

# Hostinger Mail API token (hPanel > Emails > Agentic Mail > API access).
# Required for live email. Leave blank to use sample data only.
# Set the real value ONLY in your private .env.local, never in this template.
# Do not prefix this setting with NEXT_PUBLIC_: it must stay on the server.
HOSTINGER_MAIL_API_TOKEN=

# Optional label shown for the server-managed connection.
HOSTINGER_MAIL_CONNECTION_NAME="Business email"

# Restart the dashboard after changing the token or connection name.
# Create the dashboard login password in the UI on the first visit.
# The server address and port remain 127.0.0.1:4387 for SSH tunnel access.
