# Optional configuration. Copy this file to .env.local in the project root.
# Next.js loads .env.local when you start or build the dashboard.
# Keep your actual .env.local private; Git ignores it.

# Private SQLite database and encryption-key directory.
# Relative paths resolve from the project directory. Default: .maildesk
# For a custom location, use a private absolute path outside the Git repository.
MAILDESK_DATA_DIR=.maildesk

# Disable Next.js telemetry. The supplied launchers also set this to 1.
NEXT_TELEMETRY_DISABLED=1

# Configure Hostinger API tokens and your dashboard password in the dashboard UI.
# They are not read from environment variables. Do not put them in this template.
# The server address and port remain 127.0.0.1:4387 for SSH tunnel access.
